{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "passenger": {
      "env": {
        "APP_VARIANT": "passenger"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "driver": {
      "env": {
        "APP_VARIANT": "driver"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
